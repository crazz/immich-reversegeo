@page "/data/geoboundaries"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using ImmichReverseGeo.Core.WorkerJobs
@inject GadmDivisionCacheService GadmCache
@inject OvertureDivisionCacheService OvertureCache
@inject CacheMutationPageControllerFactory CacheMutations
@inject CacheDeletionPageControllerFactory CacheDeletions

<h2>Administrative Areas</h2>

@if (_deletionController?.State.Confirmation is { } confirmation)
{
    <div class="alert alert-info" role="dialog" aria-label="Confirm cache deletion">
        <div>@confirmation.Prompt</div>
        <div class="btn-row">
            <button type="button" class="btn btn-danger"
                    @onclick="() => ConfirmDeletion(confirmation.Generation)">
                @(confirmation.IsBatch ? "Confirm Delete All" : "Confirm Delete")
            </button>
            <button type="button" class="btn btn-secondary"
                    @onclick="() => DismissDeletion(confirmation.Generation)">
                Keep caches
            </button>
        </div>
    </div>
}

@if (_deletionController is not null
    && _deletionController.State.Phase != CacheDeletionPagePhase.Idle
    && _deletionController.State.Phase != CacheDeletionPagePhase.Confirming)
{
    var deletion = _deletionController.State;
    <div class="alert @DeletionAlertClass" role="status" aria-live="polite">
        @if (deletion.Status is not null)
        {
            <div>@deletion.Status</div>
        }
        @if (deletion.Error is not null)
        {
            <div>@deletion.Error</div>
        }
        @if (deletion.Result?.BusyOwner is ExclusiveHeavyOwnerBusyMetadata.Worker busyWorker)
        {
            <div>Active: @busyWorker.Job.CapabilityFamily / @busyWorker.Job.Origin / @busyWorker.Job.Lifecycle</div>
        }
        else if (deletion.Result?.BusyOwner is ExclusiveHeavyOwnerBusyMetadata.CacheMaintenance)
        {
            <div>Active: cache maintenance</div>
        }
    </div>
    @if (deletion.ReloadError is not null)
    {
        <div class="alert alert-error" role="status" aria-live="polite">@deletion.ReloadError</div>
    }
}

@if (_cacheController is not null && _cacheController.State.Phase != CacheMutationPagePhase.Idle)
{
    var mutation = _cacheController.State;
    <div class="alert @MutationAlertClass">
        <div>@mutation.Status</div>
        @if (mutation.Error is not null)
        {
            <div>@mutation.Error</div>
        }
        @if (mutation.CurrentActivity is not null)
        {
            <div>@mutation.CurrentActivity</div>
        }
        @if (mutation.BusyOwner is ExclusiveHeavyOwnerBusyMetadata.Worker busyWorker)
        {
            <div>Active: @busyWorker.Job.CapabilityFamily / @busyWorker.Job.Origin / @busyWorker.Job.Lifecycle</div>
        }
        else if (mutation.BusyOwner is ExclusiveHeavyOwnerBusyMetadata.CacheMaintenance)
        {
            <div>Active: cache maintenance</div>
        }
        @if (mutation.CanCancel)
        {
            <button type="button" class="btn btn-secondary" @onclick="CancelCacheMutation">Cancel</button>
        }
    </div>
}

<p class="section-intro">
    GADM data is available for academic and other non-commercial use.
    <a href="https://gadm.org/license.html" target="_blank" rel="noopener noreferrer">Review the GADM license</a>.
</p>

<div class="administrative-cache-page">
<section class="settings-card wide-card">
    <h3>Administrative Area Caches</h3>
    <p class="section-intro">Downloaded Overture and optional GADM administrative caches are reused for processing and lookup. Use the filters below to inspect one source or search by country code.</p>
    <div class="btn-row">
        <button @onclick="DeleteAllOvertureDivisions"
                disabled="@MutationControlsDisabled"
                class="btn btn-danger">
            Delete All Overture Divisions
        </button>
        <button @onclick="DeleteAllGadmDivisions"
                disabled="@MutationControlsDisabled"
                class="btn btn-danger">
            Delete All GADM Caches
        </button>
    </div>
    <div class="cache-filters">
        <div class="input-group">
            <label for="cache-source-filter">Source</label>
            <select id="cache-source-filter" @bind="_selectedSourceFilter">
                <option value="@CacheSourceFilter.All">All</option>
                <option value="@CacheSourceFilter.Overture">Overture</option>
                <option value="@CacheSourceFilter.Gadm">GADM</option>
            </select>
        </div>
        <div class="input-group">
            <label for="cache-search-filter">Country code</label>
            <input id="cache-search-filter"
                   type="text"
                   class="form-control"
                   placeholder="CHE"
                   @bind="_countrySearch"
                   @bind:event="oninput" />
        </div>
    </div>

    @if (GetFilteredRows().Count == 0)
    {
        <p>No cached administrative area data matches the current filters.</p>
    }
    else
    {
        <div class="table-scroll">
        <table class="data-table cache-table">
            <thead>
                <tr>
                    <th><button type="button" class="table-sort-btn" @onclick="() => SortBy(CacheSortColumn.Source)"><span>Source</span><span class="sort-indicator">@SortIndicator(CacheSortColumn.Source)</span></button></th>
                    <th><button type="button" class="table-sort-btn" @onclick="() => SortBy(CacheSortColumn.Country)"><span>Country</span><span class="sort-indicator">@SortIndicator(CacheSortColumn.Country)</span></button></th>
                    <th><button type="button" class="table-sort-btn" @onclick="() => SortBy(CacheSortColumn.AreaCount)"><span>Area Count</span><span class="sort-indicator">@SortIndicator(CacheSortColumn.AreaCount)</span></button></th>
                    <th><button type="button" class="table-sort-btn" @onclick="() => SortBy(CacheSortColumn.Version)"><span>Version / Release</span><span class="sort-indicator">@SortIndicator(CacheSortColumn.Version)</span></button></th>
                    <th><button type="button" class="table-sort-btn" @onclick="() => SortBy(CacheSortColumn.Size)"><span>Size</span><span class="sort-indicator">@SortIndicator(CacheSortColumn.Size)</span></button></th>
                    <th><button type="button" class="table-sort-btn" @onclick="() => SortBy(CacheSortColumn.DownloadedAt)"><span>Downloaded At</span><span class="sort-indicator">@SortIndicator(CacheSortColumn.DownloadedAt)</span></button></th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in GetFilteredRows())
                {
                    <tr>
                        <td><span class="source-badge @row.SourceCssClass">@row.SourceLabel</span></td>
                        <td><code>@row.Iso3</code></td>
                        <td>@row.RowCount.ToString("N0")</td>
                        <td>@(row.Version ?? "—")</td>
                        <td>@FormatFileSize(row.FileSizeBytes)</td>
                        <td>@row.DownloadedAt?.ToString("u")</td>
                        <td class="table-actions-cell">
                            <button @onclick="() => DeleteCache(row)"
                                    disabled="@MutationControlsDisabled"
                                    class="btn btn-danger">
                                Delete
                            </button>
                            <button @onclick="() => RedownloadCache(row)"
                                    disabled="@MutationControlsDisabled"
                                    class="btn btn-secondary">
                                Re-download
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
</section>
</div>

@code {
    private Dictionary<string, OvertureDivisionStatus> _overtureDivisionStatus = [];
    private Dictionary<string, GadmDivisionStatus> _gadmDivisionStatus = [];
    private CacheMutationPageController? _cacheController;
    private CacheDeletionPageController? _deletionController;
    private bool _disposed;
    private CacheSortColumn _sortColumn = CacheSortColumn.Source;
    private bool _sortAscending = true;
    private CacheSourceFilter _selectedSourceFilter = CacheSourceFilter.All;
    private string _countrySearch = string.Empty;

    protected override Task OnInitializedAsync()
    {
        RefreshState();
        _cacheController = CacheMutations.Create(
            NotifyPageChangedAsync,
            ReloadPageStateAsync);
        _deletionController = CacheDeletions.Create(
            NotifyPageChangedAsync,
            ReloadPageStateAsync);
        return Task.CompletedTask;
    }

    protected override bool ShouldRender() =>
        !System.Threading.Volatile.Read(ref _disposed);

    private Task NotifyPageChangedAsync() => InvokeAsync(() =>
    {
        if (System.Threading.Volatile.Read(ref _disposed))
        {
            return;
        }

        StateHasChanged();
    });

    private Task ReloadPageStateAsync() => InvokeAsync(() =>
    {
        if (System.Threading.Volatile.Read(ref _disposed))
        {
            return;
        }

        RefreshState();
        StateHasChanged();
    });

    private bool MutationControlsDisabled =>
        (_cacheController?.State.IsActive ?? false)
        || (_deletionController?.State.ControlsDisabled ?? false);

    private string MutationAlertClass => _cacheController?.State.Phase switch
    {
        CacheMutationPagePhase.Completed => "alert-success",
        CacheMutationPagePhase.Failed => "alert-error",
        _ => "alert-info"
    };

    private string DeletionAlertClass
    {
        get
        {
            CacheDeletionPageState? deletion = _deletionController?.State;
            if (deletion?.Phase is CacheDeletionPagePhase.Deleting
                or CacheDeletionPagePhase.Reloading
                or CacheDeletionPagePhase.Busy)
            {
                return "alert-info";
            }

            if (deletion is
                {
                    Phase: CacheDeletionPagePhase.Completed,
                    ReloadError: null,
                    Result: { FailedCount: 0, InvalidCount: 0 }
                })
            {
                return "alert-success";
            }

            return "alert-error";
        }
    }

    private void RefreshState()
    {
        _overtureDivisionStatus = OvertureCache.GetStatus();
        _gadmDivisionStatus = GadmCache.GetStatus();
    }

    private Task RedownloadOvertureDivision(string iso3)
    {
        return _cacheController?.RefreshAsync(CacheMutationSource.Overture, iso3)
            ?? Task.CompletedTask;
    }

    private Task DeleteOvertureDivision(string iso3)
    {
        _deletionController?.RequestDelete(
            new CacheDeletionTarget(CacheMutationSource.Overture, iso3));
        return Task.CompletedTask;
    }

    private Task DeleteAllOvertureDivisions()
    {
        CacheDeletionTarget[] targets = _overtureDivisionStatus.Keys
            .Select(iso3 => new CacheDeletionTarget(CacheMutationSource.Overture, iso3))
            .ToArray();
        _deletionController?.RequestDeleteAll(CacheMutationSource.Overture, targets);
        return Task.CompletedTask;
    }

    private Task RedownloadGadmDivision(string iso3)
    {
        return _cacheController?.RefreshAsync(CacheMutationSource.Gadm, iso3)
            ?? Task.CompletedTask;
    }

    private Task CancelCacheMutation() =>
        _cacheController?.CancelAsync() ?? Task.CompletedTask;

    private Task DeleteGadmDivision(string iso3)
    {
        _deletionController?.RequestDelete(
            new CacheDeletionTarget(CacheMutationSource.Gadm, iso3));
        return Task.CompletedTask;
    }

    private Task DeleteAllGadmDivisions()
    {
        CacheDeletionTarget[] targets = _gadmDivisionStatus.Keys
            .Select(iso3 => new CacheDeletionTarget(CacheMutationSource.Gadm, iso3))
            .ToArray();
        _deletionController?.RequestDeleteAll(CacheMutationSource.Gadm, targets);
        return Task.CompletedTask;
    }

    private Task ConfirmDeletion(long generation) =>
        _deletionController?.ConfirmAsync(generation) ?? Task.CompletedTask;

    private void DismissDeletion(long generation) =>
        _deletionController?.DismissConfirmation(generation);

    private Task DeleteCache(CacheRow row)
    {
        return row.Source switch
        {
            CacheSource.Overture => DeleteOvertureDivision(row.Iso3),
            CacheSource.Gadm => DeleteGadmDivision(row.Iso3),
            _ => Task.CompletedTask
        };
    }

    private Task RedownloadCache(CacheRow row)
    {
        return row.Source switch
        {
            CacheSource.Overture => RedownloadOvertureDivision(row.Iso3),
            CacheSource.Gadm => RedownloadGadmDivision(row.Iso3),
            _ => Task.CompletedTask
        };
    }

    private IReadOnlyList<CacheRow> GetFilteredRows()
    {
        var rows = _overtureDivisionStatus
            .Select(pair => new CacheRow(CacheSource.Overture, pair.Key, "Overture", pair.Value.RowCount, pair.Value.Release, pair.Value.FileSizeBytes, pair.Value.DownloadedAt))
            .Concat(_gadmDivisionStatus.Select(pair => new CacheRow(CacheSource.Gadm, pair.Key, "GADM", pair.Value.RowCount, pair.Value.Version, pair.Value.FileSizeBytes, pair.Value.DownloadedAt)));

        if (_selectedSourceFilter == CacheSourceFilter.Overture)
        {
            rows = rows.Where(row => row.Source == CacheSource.Overture);
        }
        else if (_selectedSourceFilter == CacheSourceFilter.Gadm)
        {
            rows = rows.Where(row => row.Source == CacheSource.Gadm);
        }

        if (!string.IsNullOrWhiteSpace(_countrySearch))
        {
            rows = rows.Where(row => row.Iso3.Contains(_countrySearch.Trim(), StringComparison.OrdinalIgnoreCase));
        }

        IOrderedEnumerable<CacheRow> ordered = _sortColumn switch
        {
            CacheSortColumn.Country => rows.OrderBy(row => row.Iso3, StringComparer.OrdinalIgnoreCase),
            CacheSortColumn.AreaCount => rows.OrderBy(row => row.RowCount),
            CacheSortColumn.Version => rows.OrderBy(row => row.Version ?? string.Empty, StringComparer.OrdinalIgnoreCase),
            CacheSortColumn.Size => rows.OrderBy(row => row.FileSizeBytes ?? -1),
            CacheSortColumn.DownloadedAt => rows.OrderBy(row => row.DownloadedAt ?? DateTime.MinValue),
            _ => rows.OrderBy(row => row.SourceLabel, StringComparer.OrdinalIgnoreCase)
        };

        return (_sortAscending ? ordered : ordered.Reverse()).ToList();
    }

    private void SortBy(CacheSortColumn column)
    {
        if (_sortColumn == column)
        {
            _sortAscending = !_sortAscending;
            return;
        }

        _sortColumn = column;
        _sortAscending = true;
    }

    private string SortIndicator(CacheSortColumn column)
    {
        if (_sortColumn != column)
        {
            return string.Empty;
        }

        return _sortAscending ? " ↑" : " ↓";
    }

    private static string FormatFileSize(long? bytes)
    {
        if (bytes is null || bytes < 0)
        {
            return "—";
        }

        string[] units = ["B", "KiB", "MiB", "GiB"];
        double size = bytes.Value;
        var unitIndex = 0;
        while (size >= 1024 && unitIndex < units.Length - 1)
        {
            size /= 1024;
            unitIndex++;
        }

        return unitIndex == 0
            ? $"{size:0} {units[unitIndex]}"
            : $"{size:0.##} {units[unitIndex]}";
    }

    private sealed record CacheRow(
        CacheSource Source,
        string Iso3,
        string SourceLabel,
        long RowCount,
        string? Version,
        long? FileSizeBytes,
        DateTime? DownloadedAt)
    {
        public string SourceCssClass => Source switch
        {
            CacheSource.Overture => "source-overture",
            CacheSource.Gadm => "source-gadm",
            _ => string.Empty
        };
    }

    private enum CacheSource
    {
        Overture,
        Gadm
    }

    private enum CacheSourceFilter
    {
        All,
        Overture,
        Gadm
    }

    private enum CacheSortColumn
    {
        Source,
        Country,
        AreaCount,
        Version,
        Size,
        DownloadedAt
    }

    public async ValueTask DisposeAsync()
    {
        System.Threading.Volatile.Write(ref _disposed, true);
        Task cacheDisposal = _cacheController?.DisposeAsync().AsTask() ?? Task.CompletedTask;
        Task deletionDisposal = _deletionController?.DisposeAsync().AsTask() ?? Task.CompletedTask;
        await Task.WhenAll(cacheDisposal, deletionDisposal);
    }

}
