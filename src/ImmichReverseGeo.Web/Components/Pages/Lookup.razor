@page "/lookup"
@rendermode InteractiveServer
@using ImmichReverseGeo.Core.WorkerJobs
@implements IAsyncDisposable
@inject CoordinateLookupPageControllerFactory ControllerFactory
@inject ConfigService Config

<h2>Coordinate Lookup</h2>
<p class="page-desc">Enter coordinates to inspect how the Overture-backed resolver behaves.</p>

<div class="lookup-form">
    <div class="lookup-paste-row">
        <label for="paste">Paste coordinates</label>
        <input id="paste" type="text" class="paste-input"
               placeholder="47.4647, 8.5492 or N47.4647 E8.5492"
               @oninput="OnPasteInput" disabled="@(!PageState.FormControlsEnabled)" />
        @if (_parseError is not null)
        {
            <span class="parse-error">@_parseError</span>
        }
    </div>
    <div class="lookup-coord-row">
        <div class="input-group">
            <label for="lat">Latitude</label>
            <input id="lat" type="number" step="any" placeholder="47.4647"
                   @bind="_lat" @bind:event="oninput" class="coord-input" disabled="@(!PageState.FormControlsEnabled)" />
        </div>
        <div class="input-group">
            <label for="lon">Longitude</label>
            <input id="lon" type="number" step="any" placeholder="8.5492"
                   @bind="_lon" @bind:event="oninput" class="coord-input" disabled="@(!PageState.FormControlsEnabled)" />
        </div>
        <button class="btn btn-primary" @onclick="RunLookup" disabled="@(!PageState.FormControlsEnabled)">
            @(PageState.IsActive ? "Looking up…" : "Lookup")
        </button>
        @if (PageState.HasAdmittedOperation)
        {
            <button class="btn btn-secondary" @onclick="CancelLookup" disabled="@(!PageState.CanCancel)">
                @(PageState.Phase == CoordinateLookupPagePhase.CancelRequested ? "Cancelling…" : "Cancel")
            </button>
        }
    </div>
    <div class="lookup-options-row">
        <label class="checkbox-label">
            <input type="checkbox" @bind="_includeAirportInfrastructure" disabled="@(!PageState.FormControlsEnabled)" />
            <span>Include bundled airport infrastructure lookup</span>
        </label>
        <label class="checkbox-label">
            <input type="checkbox" @bind="_includeLivePlaces" disabled="@(!PageState.FormControlsEnabled)" />
            <span>Include live Overture Places lookup (slower)</span>
        </label>
        <label class="checkbox-label">
            <input type="checkbox" @bind="_preferGadmAdministrativeAreas" disabled="@(!PageState.FormControlsEnabled)" />
            <span>Prefer cached GADM administrative areas (experimental, non-commercial)</span>
        </label>
    </div>
</div>

@if (PageState.Error is not null)
{
    <div class="alert alert-error">@PageState.Error</div>
}

@if (PageState.Phase != CoordinateLookupPagePhase.Idle)
{
    <div class="settings-card">
        <h3>Lookup Status</h3>
        <p class="section-intro">@DescribePhase(PageState.Phase)</p>
        <p class="run-info activity">@PageState.Status</p>
        @if (PageState.CurrentActivity is not null)
        {
            <p class="run-info activity">Current activity: @PageState.CurrentActivity</p>
        }
        else if (PageState.CurrentStep is not null)
        {
            <p class="run-info activity">Current step: @DescribeStep(PageState.CurrentStep.Value)</p>
        }
        @if (PageState.JobId is not null)
        {
            <p class="result-note">Worker job <span class="mono">@PageState.JobId</span></p>
        }
    </div>
}

@if (_result is not null)
{
    <div class="lookup-results">
        @if (PageState.ResultIsFromLastCompletedLookup)
        {
            <div class="result-note">Showing the last completed lookup while the latest attempt was not admitted or did not pass validation.</div>
        }
        @if (_result.TruncatedTextCount > 0)
        {
            <div class="result-note">@_result.TruncatedTextCount result text values truncated by the worker transport bound.</div>
        }
        <div class="result-card @(_result.CountryStatus == CoordinateLookupCountryStatus.Matched ? "found" : "not-found")">
            <div class="result-header">
                <span class="result-source">Country — Overture Bundled Cache</span>
                <span class="result-badge @(_result.CountryStatus == CoordinateLookupCountryStatus.Matched ? "badge-found" : "badge-miss")">
                    @DescribeCountryStatus(_result.CountryStatus)
                </span>
            </div>
            @if (_result.Iso3 is not null)
            {
                <div class="result-row"><span class="result-key">Name</span><span class="result-val">@_result.CountryName</span></div>
                <div class="result-row"><span class="result-key">ISO3</span><span class="result-val mono">@_result.Iso3</span></div>
                <div class="result-row"><span class="result-key">Alpha-2</span><span class="result-val mono">@(_result.Alpha2 ?? "—")</span></div>
            }
            else
            {
                <div class="result-note">No bundled Overture country division matched this point.</div>
            }
            @if (_result.CountryError is not null)
            {
                <div class="result-note">Country source unavailable: @_result.CountryError</div>
            }
        </div>

        <div class="result-card @(_result.OvertureDivisionState is not null ? "found" : "not-found")">
            <div class="result-header">
                <span class="result-source">Administrative Areas — Cached Overture Divisions</span>
                <span class="result-badge @SourceBadgeClass(_result.OvertureDivisionDiagnostics.State)">
                    @DescribeSourceState(_result.OvertureDivisionDiagnostics.State)
                </span>
            </div>
            @if (_result.Iso3 is null)
            {
                <div class="result-note">Country lookup must succeed before per-country division caches can be queried.</div>
            }
            else
            {
                <div class="result-row"><span class="result-key">Source status</span><span class="result-val">@DescribeSourceState(_result.OvertureDivisionDiagnostics.State)</span></div>
                <div class="result-row"><span class="result-key">State</span><span class="result-val">@(_result.OvertureDivisionState ?? "—")</span></div>
                <div class="result-row"><span class="result-key">Resolved City</span><span class="result-val">@(_result.OvertureDivisionCity ?? "—")</span></div>
                <div class="result-row"><span class="result-key">City Resolver Profile</span><span class="result-val">@(_result.CityResolverSummary ?? "—")</span></div>
                <div class="result-row"><span class="result-key">Raw Best Area</span><span class="result-val">@(_result.OvertureDivision?.Name ?? "—")</span></div>
                <div class="result-row"><span class="result-key">Raw Best Subtype</span><span class="result-val">@(_result.OvertureDivision?.SubType ?? "—")</span></div>
                <div class="result-row"><span class="result-key">Raw Best Admin Level</span><span class="result-val">@(_result.OvertureDivision?.AdminLevel?.ToString() ?? "—")</span></div>
                <div class="result-row"><span class="result-key">Cache</span><span class="result-val">@(_result.OvertureDivisionCacheReady ? "ready" : "missing")</span></div>
                <div class="result-note">Resolved City uses the configured country-aware profile. Raw Best Area shows the strongest single cached division candidate before that policy is applied.</div>
            }
            @foreach (var cache in _result.OvertureDivisionDiagnostics.Caches)
            {
                <div class="result-note">@cache.CountryCode cache: @DescribeSourceState(cache.State)@(cache.Error is null ? string.Empty : $" — {cache.Error.Message}")</div>
            }
            @if (_result.OvertureDivisionDiagnostics.OmittedCacheCount > 0)
            {
                <div class="result-note">@_result.OvertureDivisionDiagnostics.OmittedCacheCount additional cache statuses omitted by the worker transport bound.</div>
            }
            @if (_result.OvertureDivisionDiagnostics.TruncatedTextCount > 0)
            {
                <div class="result-note">@_result.OvertureDivisionDiagnostics.TruncatedTextCount source text values truncated by the worker transport bound.</div>
            }
        </div>

        <div class="result-card @(_result.GadmDivisionState is not null ? "found" : "not-found")">
            <div class="result-header">
                <span class="result-source">Administrative Areas — Cached GADM</span>
                <span class="result-badge @SourceBadgeClass(_result.GadmDivisionDiagnostics.State)">
                    @DescribeSourceState(_result.GadmDivisionDiagnostics.State)
                </span>
            </div>
            @if (_result.GadmEnabled)
            {
                <div class="result-note">@(_result.GadmDivisionDiagnostics.UsageNotice ?? CoordinateLookupGadmAttribution.UsageNotice) <a href="@CoordinateLookupGadmAttribution.LicenseUrl" target="_blank" rel="noopener noreferrer">Official GADM license</a>.</div>
            }
            @if (!_result.GadmEnabled)
            {
                <div class="result-note">Cached GADM lookup is disabled for this run.</div>
            }
            else if (_result.Iso3 is null)
            {
                <div class="result-note">Country lookup must succeed before the per-country GADM cache can be queried.</div>
            }
            else if (_result.GadmDivisionDiagnostics.Error is not null)
            {
                <div class="result-note">GADM data is unavailable: @_result.GadmDivisionDiagnostics.Error</div>
            }
            else
            {
                <div class="result-row"><span class="result-key">Source status</span><span class="result-val">@DescribeSourceState(_result.GadmDivisionDiagnostics.State)</span></div>
                <div class="result-row"><span class="result-key">State</span><span class="result-val">@(_result.GadmDivisionState ?? "—")</span></div>
                <div class="result-row"><span class="result-key">Resolved City</span><span class="result-val">@(_result.GadmDivisionCity ?? "—")</span></div>
                <div class="result-row"><span class="result-key">Raw Best Area</span><span class="result-val">@(_result.GadmDivision?.Name ?? "—")</span></div>
                <div class="result-row"><span class="result-key">Raw Best Type</span><span class="result-val">@(_result.GadmDivision?.EnglishType ?? _result.GadmDivision?.LocalType ?? "—")</span></div>
                <div class="result-row"><span class="result-key">Raw Best Admin Level</span><span class="result-val">@(_result.GadmDivision?.AdminLevel.ToString() ?? "—")</span></div>
                <div class="result-row"><span class="result-key">Cache</span><span class="result-val">@(_result.GadmDivisionCacheReady ? "ready" : "missing")</span></div>
                <div class="result-note">This experimental path still uses bundled Overture country detection to decide which country cache to load first.</div>
            }
            @foreach (var cache in _result.GadmDivisionDiagnostics.Caches)
            {
                <div class="result-note">@cache.CountryCode cache: @DescribeSourceState(cache.State)@(cache.Error is null ? string.Empty : $" — {cache.Error.Message}")</div>
            }
            @if (_result.GadmDivisionDiagnostics.OmittedCacheCount > 0)
            {
                <div class="result-note">@_result.GadmDivisionDiagnostics.OmittedCacheCount additional cache statuses omitted by the worker transport bound.</div>
            }
            @if (_result.GadmDivisionDiagnostics.TruncatedTextCount > 0)
            {
                <div class="result-note">@_result.GadmDivisionDiagnostics.TruncatedTextCount source text values truncated by the worker transport bound.</div>
            }
            @if (_result.GadmDivisionDiagnostics.Attribution is not null)
            {
                <div class="result-note">Dataset: @_result.GadmDivisionDiagnostics.Attribution@(_result.GadmDivisionDiagnostics.Version is null ? string.Empty : $" {_result.GadmDivisionDiagnostics.Version}")</div>
            }
        </div>

        <div class="result-card @(_result.OvertureInfrastructure is not null ? "found" : "not-found")">
            <div class="result-header">
                <span class="result-source">Airport Infrastructure — Bundled Overture</span>
                <span class="result-badge @SourceBadgeClass(_result.OvertureInfrastructureDiagnostics.State)">
                    @DescribeSourceState(_result.OvertureInfrastructureDiagnostics.State)
                </span>
            </div>
            @if (!_result.AirportInfrastructureEnabled)
            {
                <div class="result-note">Bundled airport infrastructure lookup is disabled for this run.</div>
            }
            else if (_result.OvertureInfrastructure is not null)
            {
                <div class="result-row"><span class="result-key">Name</span><span class="result-val">@_result.OvertureInfrastructure.Name</span></div>
                <div class="result-row"><span class="result-key">Subtype</span><span class="result-val">@(_result.OvertureInfrastructure.SubType ?? "—")</span></div>
                <div class="result-row"><span class="result-key">Class</span><span class="result-val">@(_result.OvertureInfrastructure.ClassName ?? "—")</span></div>
                <div class="result-row"><span class="result-key">BBox Contains Point</span><span class="result-val">@DescribeFact(_result.OvertureInfrastructure.BoundingBoxContainsPoint)</span></div>
                <div class="result-row"><span class="result-key">Geometry Contains Point</span><span class="result-val">@DescribeFact(_result.OvertureInfrastructure.GeometryContainsPoint)</span></div>
                <div class="result-row"><span class="result-key">Distance</span><span class="result-val">@DescribeDistance(_result.OvertureInfrastructure.DistanceMetres)</span></div>
            }
            else if (_result.Iso3 is not null)
            {
                <div class="result-note">No cached Overture airport infrastructure feature matched this point.</div>
            }
            @if (_result.Iso3 is not null && _result.AirportInfrastructureEnabled)
            {
                <div class="result-note">Ranking prefers better airport class, then real geometry matches, then bbox matches, then distance.</div>
            }
            @if (_result.OvertureInfrastructureDiagnostics.OmittedCacheCount > 0)
            {
                <div class="result-note">@_result.OvertureInfrastructureDiagnostics.OmittedCacheCount additional cache statuses omitted by the worker transport bound.</div>
            }
            @if (_result.OvertureInfrastructureDiagnostics.TruncatedTextCount > 0)
            {
                <div class="result-note">@_result.OvertureInfrastructureDiagnostics.TruncatedTextCount source text values truncated by the worker transport bound.</div>
            }
        </div>

        <div class="result-card @(_result.OverturePoi is not null ? "found" : "not-found")">
            <div class="result-header">
                <span class="result-source">Overture Places — Live Lookup</span>
                <span class="result-badge @SourceBadgeClass(_result.OvertureDiagnostics.State)">
                    @DescribeSourceState(_result.OvertureDiagnostics.State)
                </span>
            </div>
            @if (!_result.LivePlacesEnabled)
            {
                <div class="result-note">Live Overture Places lookup is disabled for this run.</div>
            }
            else if (_result.OverturePoi is not null)
            {
                <div class="result-row"><span class="result-key">Name</span><span class="result-val">@_result.OverturePoi.Name</span></div>
                <div class="result-row"><span class="result-key">Category</span><span class="result-val">@(_result.OverturePoi.Category ?? _result.OverturePoi.BasicCategory ?? "—")</span></div>
                <div class="result-row"><span class="result-key">Confidence</span><span class="result-val">@DescribeConfidence(_result.OverturePoi.Confidence)</span></div>
                <div class="result-row"><span class="result-key">Status</span><span class="result-val">@(_result.OverturePoi.OperatingStatus ?? "—")</span></div>
                <div class="result-row"><span class="result-key">BBox Contains Point</span><span class="result-val">@DescribeFact(_result.OverturePoi.BoundingBoxContainsPoint)</span></div>
                <div class="result-row"><span class="result-key">Sources</span><span class="result-val">@DescribeSources(_result.OverturePoi.Sources)</span></div>
                <div class="result-row"><span class="result-key">Distance</span><span class="result-val">@DescribeDistance(_result.OverturePoi.DistanceMetres)</span></div>
            }
            else if (_result.OvertureDiagnostics.Error is not null)
            {
                <div class="result-note">Live Overture Places lookup failed: @_result.OvertureDiagnostics.Error</div>
            }
            else if (_result.Iso3 is not null)
            {
                <div class="result-note">No live Overture place matched inside the current search window.</div>
            }
            @if (_result.LivePlacesEnabled && _result.Iso3 is not null)
            {
                <div class="result-note">Confidence below 0.90 is filtered out. Among the remaining candidates, ranking prefers active/open places, then bbox containment, then distance.</div>
            }
            @if (_result.OvertureDiagnostics.OmittedCacheCount > 0)
            {
                <div class="result-note">@_result.OvertureDiagnostics.OmittedCacheCount additional cache statuses omitted by the worker transport bound.</div>
            }
            @if (_result.OvertureDiagnostics.TruncatedTextCount > 0)
            {
                <div class="result-note">@_result.OvertureDiagnostics.TruncatedTextCount source text values truncated by the worker transport bound.</div>
            }
        </div>

        <div class="result-card final-card @(_result.FinalCity is not null ? "found" : "not-found")">
            <div class="result-header">
                <span class="result-source">Final output (what would be written to Immich)</span>
                <span class="result-badge @(_result.FinalCity is not null ? "badge-found" : "badge-miss")">
                    @(_result.FinalCity is not null ? "complete" : "incomplete — would not write")
                </span>
            </div>
            <div class="result-row"><span class="result-key">City</span><span class="result-val">@(_result.FinalCity ?? "—")</span></div>
            <div class="result-row"><span class="result-key">City Source</span><span class="result-val">@(_result.FinalCitySource ?? "—")</span></div>
            <div class="result-row"><span class="result-key">State</span><span class="result-val">@(_result.FinalState ?? "—")</span></div>
            <div class="result-row"><span class="result-key">State Source</span><span class="result-val">@(_result.FinalStateSource ?? "—")</span></div>
            <div class="result-row"><span class="result-key">Country</span><span class="result-val">@(_result.FinalCountry ?? "—")</span></div>
            <div class="result-row"><span class="result-key">Country Source</span><span class="result-val">@(_result.FinalCountrySource ?? "—")</span></div>
        </div>

        <div class="result-card trace-card">
            <div class="result-header">
                <span class="result-source">Lookup Trace</span>
                <span class="result-badge badge-found">debug</span>
            </div>
            <details class="trace-details" @attributes="GetDetailsAttributes(_expandTrace)">
                <summary class="trace-summary">Trace Lines (@_result.Trace.Count)</summary>
                <div class="trace-section">
                    @foreach (var line in _result.Trace)
                    {
                        <div class="trace-line">@line</div>
                    }
                    @if (_result.OmittedTraceCount > 0)
                    {
                        <div class="trace-line">@_result.OmittedTraceCount additional trace lines omitted by the worker transport bound.</div>
                    }
                </div>
            </details>
            @if (_result.OvertureInfrastructureDiagnostics is not null)
            {
                <details class="trace-details">
                    <summary class="trace-summary">Cached Infrastructure Candidates (@_result.OvertureInfrastructureDiagnostics.Candidates.Count considered, release @(_result.OvertureInfrastructureDiagnostics.Release ?? "unknown"))</summary>
                    <div class="trace-section">
                        @if (_result.OvertureInfrastructureDiagnostics.Error is not null)
                        {
                            <div class="trace-line">Infrastructure error: @_result.OvertureInfrastructureDiagnostics.Error</div>
                        }
                        else if (_result.OvertureInfrastructureDiagnostics.Candidates.Count == 0)
                        {
                            <div class="trace-line">No cached airport infrastructure candidates were returned.</div>
                        }
                        else
                        {
                            @foreach (var candidate in SortInfrastructureCandidates(_result.OvertureInfrastructureDiagnostics.Candidates))
                            {
                                <div class="trace-candidate @(candidate.Selected ? "selected" : null)">
                                    <div class="trace-candidate-main">
                                        <span class="trace-name">@candidate.Name</span>
                                        <span class="trace-meta">@DescribeDistance(candidate.DistanceMetres)</span>
                                        <span class="trace-meta">bbox @DescribeFact(candidate.BoundingBoxContainsPoint)</span>
                                        <span class="trace-meta">geom @DescribeFact(candidate.GeometryContainsPoint)</span>
                                        <span class="trace-meta">@((candidate.SubType ?? candidate.FeatureType ?? "unknown").ToLowerInvariant())</span>
                                    </div>
                                    <div class="trace-candidate-sub">
                                        <span class="mono">@candidate.Id</span>
                                        <span>@(candidate.ClassName ?? "unclassified")</span>
                                        <span>@candidate.Decision</span>
                                    </div>
                                    @if (candidate.OmittedRecordSourceCount > 0)
                                    {
                                        <div class="trace-candidate-sub">@candidate.OmittedRecordSourceCount additional record sources omitted by the worker transport bound.</div>
                                    }
                                    @if (candidate.TruncatedTextCount > 0)
                                    {
                                        <div class="trace-candidate-sub">@candidate.TruncatedTextCount candidate text values truncated by the worker transport bound.</div>
                                    }
                                </div>
                            }
                        }
                        @if (_result.OvertureInfrastructureDiagnostics.OmittedCandidateCount > 0)
                        {
                            <div class="trace-line">@_result.OvertureInfrastructureDiagnostics.OmittedCandidateCount additional candidates omitted by the worker transport bound.</div>
                        }
                    </div>
                </details>
            }
            @if (_result.OvertureDivisionDiagnostics is not null)
            {
                <details class="trace-details">
                    <summary class="trace-summary">Cached Division Areas (@_result.OvertureDivisionDiagnostics.Candidates.Count considered, release @(_result.OvertureDivisionDiagnostics.Release ?? "unknown"))</summary>
                    <div class="trace-section">
                        @if (_result.OvertureDivisionDiagnostics.Error is not null)
                        {
                            <div class="trace-line">Division error: @_result.OvertureDivisionDiagnostics.Error</div>
                        }
                        else if (_result.OvertureDivisionDiagnostics.Candidates.Count == 0)
                        {
                            <div class="trace-line">No cached division areas were returned for the point.</div>
                        }
                        else
                        {
                            @foreach (var candidate in SortDivisionCandidates(_result.OvertureDivisionDiagnostics.Candidates))
                            {
                                <div class="trace-candidate @(candidate.Selected ? "selected" : null)">
                                    <div class="trace-candidate-main">
                                        <span class="trace-name">@candidate.Name</span>
                                        <span class="trace-meta">@((candidate.SubType ?? "unknown").ToLowerInvariant())</span>
                                        <span class="trace-meta">admin @((candidate.AdminLevel?.ToString()) ?? "—")</span>
                                        <span class="trace-meta">bbox @DescribeFact(candidate.BoundingBoxContainsPoint)</span>
                                        <span class="trace-meta">geom @DescribeFact(candidate.GeometryContainsPoint)</span>
                                        <span class="trace-meta">territorial @DescribeFact(candidate.IsTerritorial)</span>
                                    </div>
                                    <div class="trace-candidate-sub">
                                        <span class="mono">@candidate.Id</span>
                                        <span>@(candidate.ClassName ?? "unclassified")</span>
                                        <span>@(candidate.Country ?? "—")</span>
                                        <span>bbox area @DescribeArea(candidate.BoundingBoxArea)</span>
                                        <span>@candidate.Decision</span>
                                    </div>
                                    @if (candidate.OmittedRecordSourceCount > 0)
                                    {
                                        <div class="trace-candidate-sub">@candidate.OmittedRecordSourceCount additional record sources omitted by the worker transport bound.</div>
                                    }
                                    @if (candidate.TruncatedTextCount > 0)
                                    {
                                        <div class="trace-candidate-sub">@candidate.TruncatedTextCount candidate text values truncated by the worker transport bound.</div>
                                    }
                                </div>
                            }
                        }
                        @if (_result.OvertureDivisionDiagnostics.OmittedCandidateCount > 0)
                        {
                            <div class="trace-line">@_result.OvertureDivisionDiagnostics.OmittedCandidateCount additional candidates omitted by the worker transport bound.</div>
                        }
                    </div>
                </details>
            }
            @if (_result.GadmDivisionDiagnostics is not null)
            {
                <details class="trace-details">
                    <summary class="trace-summary">Cached GADM Areas (@_result.GadmDivisionDiagnostics.Candidates.Count considered, version @(_result.GadmDivisionDiagnostics.Version ?? "unknown"))</summary>
                    <div class="trace-section">
                        @if (_result.GadmDivisionDiagnostics.Error is not null)
                        {
                            <div class="trace-line">GADM error: @_result.GadmDivisionDiagnostics.Error</div>
                        }
                        else if (_result.GadmDivisionDiagnostics.Candidates.Count == 0)
                        {
                            <div class="trace-line">No cached GADM areas were returned for the point.</div>
                        }
                        else
                        {
                            @foreach (var candidate in SortGadmCandidates(_result.GadmDivisionDiagnostics.Candidates))
                            {
                                <div class="trace-candidate @(candidate.Selected ? "selected" : null)">
                                    <div class="trace-candidate-main">
                                        <span class="trace-name">@candidate.Name</span>
                                        <span class="trace-meta">level @candidate.AdminLevel</span>
                                        <span class="trace-meta">bbox @DescribeFact(candidate.BoundingBoxContainsPoint)</span>
                                        <span class="trace-meta">geom @DescribeFact(candidate.GeometryContainsPoint)</span>
                                        <span class="trace-meta">@((candidate.EnglishType ?? candidate.LocalType ?? "unknown").ToLowerInvariant())</span>
                                    </div>
                                    <div class="trace-candidate-sub">
                                        <span class="mono">@candidate.Id</span>
                                        <span>bbox area @DescribeArea(candidate.BoundingBoxArea)</span>
                                        <span>@candidate.Decision</span>
                                    </div>
                                    @if (candidate.OmittedRecordSourceCount > 0)
                                    {
                                        <div class="trace-candidate-sub">@candidate.OmittedRecordSourceCount additional record sources omitted by the worker transport bound.</div>
                                    }
                                    @if (candidate.TruncatedTextCount > 0)
                                    {
                                        <div class="trace-candidate-sub">@candidate.TruncatedTextCount candidate text values truncated by the worker transport bound.</div>
                                    }
                                </div>
                            }
                        }
                        @if (_result.GadmDivisionDiagnostics.OmittedCandidateCount > 0)
                        {
                            <div class="trace-line">@_result.GadmDivisionDiagnostics.OmittedCandidateCount additional candidates omitted by the worker transport bound.</div>
                        }
                    </div>
                </details>
            }
            @if (_result.OvertureDiagnostics is not null)
            {
                <details class="trace-details">
                    <summary class="trace-summary">Live Overture Places (@_result.OvertureDiagnostics.Candidates.Count considered, release @(_result.OvertureDiagnostics.Release ?? "unknown"))</summary>
                    <div class="trace-section">
                        @if (_result.OvertureDiagnostics.Error is not null)
                        {
                            <div class="trace-line">Places error: @_result.OvertureDiagnostics.Error</div>
                        }
                        else if (_result.OvertureDiagnostics.Candidates.Count == 0)
                        {
                            <div class="trace-line">No live Overture places were returned inside the search window.</div>
                        }
                        else
                        {
                            @foreach (var candidate in SortPlaceCandidates(_result.OvertureDiagnostics.Candidates))
                            {
                                <div class="trace-candidate @(candidate.Selected ? "selected" : null)">
                                    <div class="trace-candidate-main">
                                        <span class="trace-name">@candidate.Name</span>
                                        <span class="trace-meta">@DescribeDistance(candidate.DistanceMetres)</span>
                                        <span class="trace-meta">conf @DescribeConfidence(candidate.Confidence)</span>
                                        <span class="trace-meta">bbox @DescribeFact(candidate.BoundingBoxContainsPoint)</span>
                                        <span class="trace-meta">@((candidate.OperatingStatus ?? "unknown").ToLowerInvariant())</span>
                                    </div>
                                    <div class="trace-candidate-sub">
                                        <span class="mono">@candidate.Id</span>
                                        <span>@(candidate.Category ?? candidate.BasicCategory ?? "uncategorized")</span>
                                        <span>@DescribeSources(candidate.Sources)</span>
                                        <span>@candidate.Decision</span>
                                    </div>
                                    @if (candidate.OmittedRecordSourceCount > 0)
                                    {
                                        <div class="trace-candidate-sub">@candidate.OmittedRecordSourceCount additional record sources omitted by the worker transport bound.</div>
                                    }
                                    @if (candidate.TruncatedTextCount > 0)
                                    {
                                        <div class="trace-candidate-sub">@candidate.TruncatedTextCount candidate text values truncated by the worker transport bound.</div>
                                    }
                                </div>
                            }
                        }
                        @if (_result.OvertureDiagnostics.OmittedCandidateCount > 0)
                        {
                            <div class="trace-line">@_result.OvertureDiagnostics.OmittedCandidateCount additional candidates omitted by the worker transport bound.</div>
                        }
                    </div>
                </details>
            }
        </div>
    </div>
}

@code {
    private double _lat;
    private double _lon;
    private string? _parseError;
    private bool _expandTrace = true;
    private bool _includeAirportInfrastructure = true;
    private bool _includeLivePlaces;
    private bool _preferGadmAdministrativeAreas;
    private CoordinateLookupPageController? _controller;
    private CoordinateLookupResult? _displaySource;
    private CoordinateLookupDisplayResult? _displayResult;
    private bool _renderingDisposed;

    private CoordinateLookupPageState PageState =>
        _controller?.State ?? CoordinateLookupPageState.Idle;

    private CoordinateLookupDisplayResult? _result
    {
        get
        {
            CoordinateLookupResult? source = PageState.Result;
            if (!ReferenceEquals(source, _displaySource))
            {
                _displaySource = source;
                _displayResult = source is null ? null : new CoordinateLookupDisplayResult(source);
            }

            return _displayResult;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _controller = ControllerFactory.Create(QueueRender);
        try
        {
            var config = await Config.GetConfigAsync();
            _includeAirportInfrastructure = config.Processing.UseAirportInfrastructure;
        }
        catch
        {
            _includeAirportInfrastructure = true;
        }
    }

    private void OnPasteInput(ChangeEventArgs e)
    {
        if (!PageState.FormControlsEnabled)
        {
            return;
        }

        string text = e.Value?.ToString() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(text))
        {
            _parseError = null;
            return;
        }

        if (CoordinateLookupInputParser.TryParse(text, out double latitude, out double longitude))
        {
            _lat = latitude;
            _lon = longitude;
            _parseError = null;
        }
        else
        {
            _parseError = "Could not parse coordinates";
        }
    }

    private Task RunLookup()
    {
        _parseError = null;
        return _controller?.SubmitAsync(new CoordinateLookupSubmission(
            _lat,
            _lon,
            _includeAirportInfrastructure,
            _includeLivePlaces,
            _preferGadmAdministrativeAreas)) ?? Task.CompletedTask;
    }

    private Task CancelLookup()
    {
        return _controller?.CancelAsync() ?? Task.CompletedTask;
    }

    private void QueueRender()
    {
        if (_renderingDisposed)
        {
            return;
        }

        _ = RenderAsync();
    }

    private async Task RenderAsync()
    {
        try
        {
            await InvokeAsync(() =>
            {
                if (!_renderingDisposed)
                {
                    StateHasChanged();
                }
            });
        }
        catch (InvalidOperationException) when (_renderingDisposed)
        {
        }
        catch (ObjectDisposedException) when (_renderingDisposed)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        _renderingDisposed = true;
        CoordinateLookupPageController? controller =
            System.Threading.Interlocked.Exchange(ref _controller, null);
        if (controller is not null)
        {
            await controller.DisposeAsync();
        }
    }

    private static string DescribePhase(CoordinateLookupPagePhase phase)
    {
        return phase switch
        {
            CoordinateLookupPagePhase.Validating => "Validating the local coordinate input.",
            CoordinateLookupPagePhase.Admitting => "Checking isolated worker availability.",
            CoordinateLookupPagePhase.Starting => "Starting the isolated lookup worker.",
            CoordinateLookupPagePhase.Running => "The isolated lookup worker is running.",
            CoordinateLookupPagePhase.CancelRequested => "Waiting for the active lookup worker to stop and finish cleanup.",
            CoordinateLookupPagePhase.Completed => "The lookup completed.",
            CoordinateLookupPagePhase.Cancelled => "The lookup was cancelled.",
            CoordinateLookupPagePhase.Busy => "The worker resource is busy.",
            CoordinateLookupPagePhase.Unavailable => "The isolated lookup worker is unavailable.",
            CoordinateLookupPagePhase.Failed => "The lookup failed safely.",
            _ => "Ready to look up coordinates."
        };
    }

    private static string DescribeStep(CoordinateLookupProgressStep step)
    {
        return step switch
        {
            CoordinateLookupProgressStep.Country => "Country",
            CoordinateLookupProgressStep.OvertureCache => "Overture cache",
            CoordinateLookupProgressStep.OvertureAdministrative => "Overture administrative areas",
            CoordinateLookupProgressStep.GadmCache => "GADM cache",
            CoordinateLookupProgressStep.GadmAdministrative => "GADM administrative areas",
            CoordinateLookupProgressStep.Airport => "Airport infrastructure",
            CoordinateLookupProgressStep.LivePlaces => "Live Overture Places",
            CoordinateLookupProgressStep.FinalSelection => "Final selection",
            _ => step.ToString()
        };
    }

    private static string DescribeSources(IReadOnlyList<string> sources)
    {
        return sources.Count == 0 ? "—" : string.Join(", ", sources);
    }

    private static string DescribeCountryStatus(CoordinateLookupCountryStatus status)
    {
        return status switch
        {
            CoordinateLookupCountryStatus.Matched => "found",
            CoordinateLookupCountryStatus.NoMatch => "no match",
            CoordinateLookupCountryStatus.MappingFailed => "mapping unavailable",
            CoordinateLookupCountryStatus.Failed => "failed",
            _ => "unknown"
        };
    }

    private static string DescribeSourceState(CoordinateLookupSourceState state)
    {
        return state switch
        {
            CoordinateLookupSourceState.Disabled => "disabled",
            CoordinateLookupSourceState.Skipped => "skipped",
            CoordinateLookupSourceState.Ready => "ready",
            CoordinateLookupSourceState.NoMatch => "no match",
            CoordinateLookupSourceState.Unavailable => "unavailable",
            CoordinateLookupSourceState.Failed => "failed",
            _ => "unknown"
        };
    }

    private static string SourceBadgeClass(CoordinateLookupSourceState state)
    {
        return state == CoordinateLookupSourceState.Ready
            ? "badge-found"
            : "badge-miss";
    }

    private static string DescribeFact(bool? value)
    {
        return value switch
        {
            true => "yes",
            false => "no",
            null => "unknown"
        };
    }

    private static string DescribeDistance(double? value)
    {
        return value is double distance
            ? $"{(int)distance} m"
            : "unknown";
    }

    private static string DescribeConfidence(double? value)
    {
        return value?.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)
            ?? "unknown";
    }

    private static string DescribeArea(double? value)
    {
        return value?.ToString("0.######", System.Globalization.CultureInfo.InvariantCulture)
            ?? "unknown";
    }

    private static IReadOnlyDictionary<string, object>? GetDetailsAttributes(bool open)
    {
        return open ? new Dictionary<string, object> { ["open"] = "open" } : null;
    }

    private static IEnumerable<CoordinateLookupDisplayCandidate> SortDivisionCandidates(
        IEnumerable<CoordinateLookupDisplayCandidate> candidates) =>
        candidates.OrderByDescending(static candidate => candidate.Selected);

    private static IEnumerable<CoordinateLookupDisplayCandidate> SortInfrastructureCandidates(
        IEnumerable<CoordinateLookupDisplayCandidate> candidates) =>
        candidates.OrderByDescending(static candidate => candidate.Selected);

    private static IEnumerable<CoordinateLookupDisplayCandidate> SortPlaceCandidates(
        IEnumerable<CoordinateLookupDisplayCandidate> candidates) =>
        candidates.OrderByDescending(static candidate => candidate.Selected);

    private static IEnumerable<CoordinateLookupDisplayCandidate> SortGadmCandidates(
        IEnumerable<CoordinateLookupDisplayCandidate> candidates) =>
        candidates.OrderByDescending(static candidate => candidate.Selected);

}
