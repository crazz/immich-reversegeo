@page "/data/skip-list"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject ISkippedAssetsCountReader Skipped
@inject IDatabaseMaintenanceController Maintenance

<header class="page-header">
    <h2>Skip list</h2>
    <div class="btn-row">
        <button @onclick="ClearSkipped" class="btn btn-danger" disabled="@(_skipOperationActive || _skippedCount == 0)">
            Clear Skip List
        </button>
    </div>
</header>

<section class="settings-card">
    <h3>Skipped Assets</h3>
    <p class="section-intro">Assets whose GPS coordinates fell outside all country boundaries (ocean, unmapped territories,
       or simplified-boundary false negatives near coastlines). These are permanently excluded from processing
       to prevent endless retries. Clear the list to re-attempt them on the next run.</p>
    <p>@_skippedCount asset(s) permanently skipped.</p>
    @if (_skipOperationActive && _skipClearResult is null)
    {
        <p class="alert alert-info" role="status" aria-live="polite">
            Skip-list maintenance is running. This operation cannot be cancelled.
        </p>
    }
    @if (_skipClearResult is not null)
    {
        <p class="alert @SkipAlertClass" role="status" aria-live="polite">@_skipClearResult.Message</p>
    }
    @if (_skipReloadError is not null)
    {
        <div class="alert alert-error" role="status" aria-live="polite">
            @_skipReloadError
            <button @onclick="ReloadSkippedCountAsync" class="btn btn-secondary" disabled="@_skipOperationActive">Reload Count</button>
        </div>
    }
</section>

@code {
    private long _skippedCount;
    private DatabaseMaintenanceResult? _skipClearResult;
    private string? _skipReloadError;
    private bool _skipOperationActive;
    private bool _disposed;
    private long _generation;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _skippedCount = await Skipped.GetCountAsync();
        }
        catch
        {
            /* SQLite not yet initialised — ignore */
        }
    }

    private async Task ClearSkipped()
    {
        if (_skipOperationActive || _disposed)
        {
            return;
        }

        long generation = ++_generation;
        _skipOperationActive = true;
        _skipClearResult = null;
        _skipReloadError = null;
        try
        {
            DatabaseMaintenanceResult result = await Maintenance.ExecuteAsync(
                new DatabaseMaintenanceRequest.ClearSkipList());
            if (!CanUpdate(generation))
            {
                return;
            }

            _skipClearResult = result;
            if (result.WasAdmitted)
            {
                await ReloadSkippedCountAsync(generation);
            }
        }
        finally
        {
            if (CanUpdate(generation))
            {
                _skipOperationActive = false;
            }
        }
    }

    private async Task ReloadSkippedCountAsync()
    {
        if (_skipOperationActive || _disposed)
        {
            return;
        }

        long generation = ++_generation;
        _skipOperationActive = true;
        _skipReloadError = null;
        try
        {
            await ReloadSkippedCountAsync(generation);
        }
        finally
        {
            if (CanUpdate(generation))
            {
                _skipOperationActive = false;
            }
        }
    }

    private async Task ReloadSkippedCountAsync(long generation)
    {
        try
        {
            long count = await Skipped.GetCountAsync();
            if (CanUpdate(generation))
            {
                _skippedCount = count;
            }
        }
        catch
        {
            if (CanUpdate(generation))
            {
                _skipReloadError = "The operation result is final, but the skipped-asset count could not be reloaded.";
            }
        }
    }

    private bool CanUpdate(long generation) => !_disposed && generation == _generation;

    private string SkipAlertClass => _skipClearResult?.Disposition == DatabaseMaintenanceDisposition.Complete
        ? "alert-success"
        : "alert-error";

    public ValueTask DisposeAsync()
    {
        _disposed = true;
        _generation++;
        return ValueTask.CompletedTask;
    }
}
