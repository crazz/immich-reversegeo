<Project>
  <PropertyGroup>
    <!-- Enable all .NET SDK analyzers at the latest rule set -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>

    <!-- Enforce .editorconfig code-style rules at build time (IDExxx diagnostics) -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Treat compiler warnings as errors -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Treat analysis warnings as errors so CI fails on new violations -->
    <AnalysisTreatWarningsAsErrors>true</AnalysisTreatWarningsAsErrors>
  </PropertyGroup>
  <PropertyGroup>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Security pin. Microsoft.Data.Sqlite 10.0.5 still resolves SQLitePCLRaw 2.1.11, which
      carries a SQLite build affected by CVE-2025-6965 / GHSA-2m69-gcr7-jv3q (high severity;
      fixed upstream in SQLite 3.50.2). NuGetAudit escalates that to NU1903, and
      TreatWarningsAsErrors turns it into a build failure.

      Pinning the bundle directly overrides the transitive version across every project.
      Remove this once Microsoft.Data.Sqlite ships a patched SQLitePCLRaw of its own.
    -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
  </ItemGroup>
</Project>
